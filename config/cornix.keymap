#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    flavor = "balanced";
    tapping-term-ms = <170>;
};

/ {
    behaviors {
        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            // At the default 16 ms scroll interval, 64 units/s gives one step per tap.
            bindings = <&msc MOVE_Y(-64)>, <&msc MOVE_Y(64)>;
            tap-ms = <20>;
        };
    };

    combos {
        compatible = "zmk,combos";

        bluetooth_combo {
            bindings = <&mo 7>;
            key-positions = <25 26>;
            layers = <0 1>;
            timeout-ms = <50>;
        };

        game_combo {
            bindings = <&tog 1>;
            key-positions = <10 13>; // P + A
            layers = <0>;
            timeout-ms = <50>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
                &kp TAB        &kp Q          &kp W          &kp E          &kp R          &kp T                       &kp Y          &kp U          &kp I          &kp O          &kp P          &kp BSLH
                &kp CAPSLOCK   &kp A          &kp S          &kp D          &kp F          &kp G                       &kp H          &kp J          &kp K          &kp L          &kp SEMI       &kp SQT
                &kp LSHFT      &kp Z          &kp X          &kp C          &kp V          &kp B          &kp C_MUTE   &mkp MB3       &kp N          &kp M          &kp COMMA      &kp DOT        &kp FSLH       &kp RSHFT
                &kp LCTRL      &kp LALT       &mo 4          &kp LGUI       &lt 2 SPACE    &mo 3                       &kp RET        &lt 6 BSPC     &lt 5 RGUI     &kp DELETE     &kp ESC        &kp F20
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>, <&scroll_encoder>;
        };

        game_layer {
            display-name = "Game";
            // Inherit Base so changes to the typing keys also apply in Game.
            bindings = <
                &trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &tog 1
                &trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
            >;
        };

        symbols_layer {
            display-name = "Symbols";
            bindings = <
                &kp ESC        &kp GRAVE      &kp LS(GRAVE)  &none          &none          &none                       &kp BSLH       &kp LS(N9)     &kp LS(N0)     &none          &none          &none
                &none          &kp LS(N1)     &kp LS(N2)     &kp LS(N3)     &kp LS(N4)     &kp LS(N5)                  &kp LS(BSLH)   &kp LBKT       &kp RBKT       &kp MINUS      &kp EQUAL      &none
                &kp LSHFT      &kp LS(N6)     &kp LS(N7)     &kp LS(N8)     &none          &kp COMMA      &kp C_MUTE   &mkp MB3       &kp DOT        &kp LS(LBKT)   &kp LS(RBKT)   &kp LS(MINUS)  &kp KP_PLUS    &none
                &kp LCTRL      &kp LALT       &none          &kp LGUI       &trans         &none                       &kp RET        &kp BSPC       &kp LS(COMMA)  &kp LS(DOT)    &none          &none
            >;
        };

        navigation_layer {
            display-name = "Navigation";
            bindings = <
                &none          &none          &none          &none          &none          &none                       &kp LG(LEFT)   &kp LG(DOWN)   &kp LG(UP)     &kp LG(RIGHT)  &none          &none
                &none          &kp LGUI       &kp LALT       &kp LCTRL      &kp LSHFT      &none                       &kp LEFT       &kp DOWN       &kp UP         &kp RIGHT      &none          &none
                &none          &none          &none          &none          &none          &none          &kp C_MUTE   &mkp MB3       &kp LA(LEFT)   &kp LA(RIGHT)  &none          &none          &none          &none
                &none          &none          &none          &none          &none          &trans                      &kp RET        &kp BSPC       &none          &kp DELETE     &none          &none
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
                &none          &none          &none          &none          &none          &none                       &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP   &msc SCRL_RIGHT  &none          &none
                &none          &kp LGUI       &kp LALT       &kp LCTRL      &kp LSHFT      &none                       &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP   &mmv MOVE_RIGHT  &none          &none
                &none          &none          &none          &none          &none          &none          &kp C_MUTE   &mkp MB3       &none          &none          &none          &none          &none          &none
                &none          &none          &trans         &none          &none          &none                       &mkp MB1       &mkp MB2       &none          &none          &none          &none
            >;
        };

        function_layer {
            display-name = "Function";
            bindings = <
                &none          &kp F12        &kp F7         &kp F8         &kp F9         &none                       &none          &none          &none          &none          &none          &none
                &none          &kp F11        &kp F4         &kp F5         &kp F6         &none                       &none          &kp RSHFT      &kp RCTRL      &kp RALT       &kp LGUI       &none
                &none          &kp F10        &kp F1         &kp F2         &kp F3         &none          &kp C_MUTE   &mkp MB3       &none          &none          &none          &none          &none          &none
                &none          &none          &none          &none          &none          &none                       &none          &none          &trans         &none          &none          &none
            >;
        };

        number_layer {
            display-name = "Numbers";
            bindings = <
                &none          &kp FSLH       &kp N7         &kp N8         &kp N9         &kp LS(EQUAL)               &none          &none          &none          &none          &none          &none
                &none          &none          &kp N4         &kp N5         &kp N6         &kp EQUAL                   &none          &kp RSHFT      &kp RCTRL      &kp RALT       &kp LGUI       &none
                &none          &none          &kp N1         &kp N2         &kp N3         &none          &kp C_MUTE   &mkp MB3       &none          &none          &none          &none          &none          &none
                &none          &none          &none          &kp DOT        &kp N0         &kp MINUS                   &none          &trans         &none          &none          &none          &none
            >;
        };

        bluetooth_layer {
            display-name = "Bluetooth";
            bindings = <
                &none          &none          &none          &none          &none          &none                       &none          &none          &none          &none          &none          &none
                &none          &none          &none          &none          &none          &none                       &none          &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &none          &none
                &none          &none          &none          &none          &none          &none          &kp C_MUTE   &mkp MB3       &none          &none          &none          &none          &none          &none
                &none          &none          &none          &none          &none          &none                       &none          &none          &none          &none          &none          &none
            >;
        };

        layer_8 {
            display-name = "Layer 8";
            bindings = <
                &none          &none          &none          &none          &none          &none                       &none          &none          &none          &none          &none          &none
                &none          &none          &none          &none          &none          &none                       &none          &none          &none          &none          &none          &none
                &none          &none          &none          &none          &none          &none          &kp C_MUTE   &mkp MB3       &none          &none          &none          &none          &none          &none
                &none          &none          &none          &none          &none          &none                       &none          &none          &none          &none          &none          &none
            >;
        };

        layer_9 {
            display-name = "Layer 9";
            bindings = <
                &none          &none          &none          &none          &none          &none                       &none          &none          &none          &none          &none          &none
                &none          &none          &none          &none          &none          &none                       &none          &none          &none          &none          &none          &none
                &none          &none          &none          &none          &none          &none          &kp C_MUTE   &mkp MB3       &none          &none          &none          &none          &none          &none
                &none          &none          &none          &none          &none          &none                       &none          &none          &none          &none          &none          &none
            >;
        };
    };
};
